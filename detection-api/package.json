{
  "name": "detection-api",
  "version": "1.5.0",
  "description": "智能多Web应用门户系统 - Clean Architecture API服务",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env PM2_ENABLED=1 tsx watch src/server.ts",
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.prod.json",
    "build:check": "tsc --noEmit",
    "start": "cross-env PM2_ENABLED=1 tsx src/server.ts",
    "start:prod": "cross-env PM2_ENABLED=1 node dist/server.js",
    "migrate": "tsx src/scripts/migrate-database.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write src/",
    "setup:dev": "node -e \"require('fs').copyFileSync('../configs/development.env', '.env')\"",
    "setup:prod": "node -e \"require('fs').copyFileSync('../configs/production.env', '.env')\""
  },
  "dependencies": {
    "@types/archiver": "^6.0.3",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/redis": "^4.0.10",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^3.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.22.2",
    "express-validator": "^7.3.2",
    "fast-glob": "^3.3.0",
    "glob": "^10.5.0",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.7",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.0",
    "node-cron": "^4.2.1",
    "ping": "^0.4.4",
    "pm2": "^7.0.1",
    "redis": "^5.8.2",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "brace-expansion@<1.1.13": "1.1.15",
    "brace-expansion@>=2.0.0 <2.0.3": "2.1.1",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "glob": {
      "minimatch": "^9.0.7"
    },
    "jsonwebtoken": {
      "jws": "^3.2.3"
    },
    "js-yaml": "^4.3.0",
    "minimatch@<3.1.4": "3.1.5",
    "minimatch@>=9.0.0 <9.0.7": "9.0.9",
    "path-to-regexp": "^0.1.13",
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4",
    "readdir-glob": {
      "minimatch": "^5.1.8"
    },
    "systeminformation": "^5.31.7",
    "tar-fs": "^2.1.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/http-proxy-middleware": "^0.19.3",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "portal",
    "detection",
    "web-apps",
    "typescript",
    "express"
  ]
}
